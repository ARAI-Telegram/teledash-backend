# ===========================================
# REQUIRED - No defaults, must be set
# ===========================================

# Storage credentials (required)
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# JWT secret for authentication (required)
JWT_SECRET=


# ===========================================
# DOCKER SERVICES - Required for docker-compose
# These are used by Docker services directly
# Set appropriate values or keep defaults
# ===========================================

# Project
COMPOSE_PROJECT_NAME=teledash

# Elasticsearch (used by Kibana and Python services)
ES_HOST=elastic
ES_PORT=9200
ES_SCHEME=http

# Flower (Celery monitoring - set credentials if using Flower)
FLOWER_USER=
FLOWER_PASSWORD=

# Live scraping (used by worker-live container -> must >= number of Telegram accounts!)
LIVE_CONCURRENCY=1


# ===========================================
# OPTIONAL - Python application settings
# Uncomment to override defaults in settings.py
# See README.md for complete documentation
# ===========================================

# --- Telegram API ---
#TELEGRAM_TEST_MODE=FALSE

# --- Storage Provider ---
#STORAGE_PROVIDER=s3-compatible
#STORAGE_REGION=
#STORAGE_USE_SSL=FALSE
#STORAGE_VERIFY_SSL=TRUE  # set FALSE to skip TLS cert verification (self-signed endpoints, e.g. NAS)
#STORAGE_ENDPOINT=minio:9000
#STORAGE_BUCKET_PREFIX=

# --- Flower (Celery monitoring) ---
#FLOWER_HOST=flower
#FLOWER_PORT=5555

# --- Scraping Configuration ---
#SCRAPE_CHATS_MAX_DAYS=7
#SCRAPE_CHATS_INTERVAL_MINUTES=30
#SCRAPE_USERS=FALSE

# --- Attachment Settings ---
#SAVE_ATTACHMENTS=TRUE
#SAVE_ATTACHMENT_TYPES='["animation","audio","document","photo","sticker","video","video_note","voice","web_page"]'
#KEEP_ATTACHMENT_FILES_DAYS=0

# --- Live Scraping ---
#LIVE_UPDATES=FALSE
#LIVE_DELETIONS=mark

# --- Authentication ---
#JWT_LIFETIME_SECONDS=3600

# --- Language Detection ---
#FALLBACK_LANGUAGE=en

# --- API Configuration ---
#API_ALLOW_ORIGINS='["http://localhost:3000"]'

# --- Semantic Search ---
#SEMANTIC_TEXT_SEARCH_API="http://text-search-api:8001/search"
#SEMANTIC_IMAGE_SEARCH_API="http://image-search-api:8002/search"